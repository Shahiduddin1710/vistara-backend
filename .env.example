# ─── VISTARA backend environment ────────────────────────────────────────────
# Copy this file to `.env` and adjust the values for your machine.
#
# DATABASE_URL / DATABASE_URL_UNPOOLED are intentionally NOT set here.
# They are pulled from Neon into `<repo root>/.env.local` by `neon env pull`
# and picked up automatically by src/config/env.ts. Set them here only if you
# want to override the Neon branch with a different database.

# PostgreSQL connection string. When this is absent (or the database is
# unreachable) the server starts in DEMO mode using a seeded in-memory store
# instead of failing. Every response then reports `"mode": "demo"`.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vistara
DATABASE_URL=postgresql://neondb_owner:npg_I0el2HfZsyxh@ep-holy-darkness-aos0il3w-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:npg_I0el2HfZsyxh@ep-holy-darkness-aos0il3w-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Secret used to sign JWT session tokens. Any long random string works.
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port the API listens on.
PORT=4000

# Comma separated list of allowed browser origins.
CORS_ORIGIN=*

# Password used by `npm run db:seed` for the demo staff accounts.
SEED_PASSWORD=12345678
