{
  "name": "vistara-backend",
  "version": "1.0.0",
  "description": "VISTARA visitor, employee card & contractor manpower management API",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-env.mjs prisma migrate dev",
    "db:push": "node scripts/prisma-env.mjs prisma db push",
    "db:seed": "node scripts/prisma-env.mjs tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma-env.mjs prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
